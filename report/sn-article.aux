\@writefile{lof}{\contentsline {figure}{\numberline {A3}{\ignorespaces Distribution of images per author for the preprocessed IAM and RIMES datasets. \textbf  {Top:} per-dataset histograms with mean (yellow) and median (orange) overlaid, showing the strong right skew of IAM compared to the broader, more centrally distributed RIMES spread. \textbf  {Bottom:} side-by-side boxplot comparison, highlighting the extreme outlier author in IAM (59 images) against the wider but shorter-tailed RIMES distribution (max 10 images).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:dataset-distribution}{{A3}{7}{Distribution of images per author for the preprocessed IAM and RIMES datasets. \textbf {Top:} per-dataset histograms with mean (yellow) and median (orange) overlaid, showing the strong right skew of IAM compared to the broader, more centrally distributed RIMES spread. \textbf {Bottom:} side-by-side boxplot comparison, highlighting the extreme outlier author in IAM (59 images) against the wider but shorter-tailed RIMES distribution (max 10 images)}{figure.3}{}}
