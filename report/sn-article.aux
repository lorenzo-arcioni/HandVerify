\@writefile{lof}{\contentsline {figure}{\numberline {A1}{\ignorespaces Preprocessing of an IAM form: the grayscale image (left) is binarized (center) to detect guide lines (red/green, detected by erosion/dilation) and the handwritten text region (blue box); this region is then extracted, cropped, and resized to $448\times 448$ pixels (right). The cropped region is also split into a $2\times 2$ grid of patches, each independently resized to $448\times 448$ pixels, so that each form yields up to five images.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:iam-preprocessing}{{A1}{5}{Preprocessing of an IAM form: the grayscale image (left) is binarized (center) to detect guide lines (red/green, detected by erosion/dilation) and the handwritten text region (blue box); this region is then extracted, cropped, and resized to $448\times 448$ pixels (right). The cropped region is also split into a $2\times 2$ grid of patches, each independently resized to $448\times 448$ pixels, so that each form yields up to five images}{figure.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {A.1.6}RIMES Dataset Preprocessing}{5}{subsubsection.a.A.1.6}\protected@file@percent }
\newlabel{app:rimes-preprocessing}{{A.1.6}{5}{RIMES Dataset Preprocessing}{subsubsection.a.A.1.6}{}}
\@writefile{toc}{\contentsline {paragraph}{Stage 1: line-level processing.}{5}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Stage 2: batch construction (per writer).}{6}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Stage 3: mosaics.}{6}{section*.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {A2}{\ignorespaces Preprocessing of RIMES text lines for a given writer. Each original line (left, e.g. \texttt  {eval2011-0\_000001.jpg}) is binarized via Otsu thresholding and tight-cropped (blue bounding boxes, center) using the projection-based algorithm; the corresponding grayscale crop is then extracted and resized to a common height (right of center). The lines of the writer are concatenated into a single strip, cut into slices of width $448$ pixels, and $5$ slices are stacked vertically into a $448\times 448$ batch (right), with unused space padded in white. Slices do not necessarily align with the original lines. Batches are subsequently combined into $2\times 2$ mosaics (not shown).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:rimes-preprocessing}{{A2}{6}{Preprocessing of RIMES text lines for a given writer. Each original line (left, e.g. \texttt {eval2011-0\_000001.jpg}) is binarized via Otsu thresholding and tight-cropped (blue bounding boxes, center) using the projection-based algorithm; the corresponding grayscale crop is then extracted and resized to a common height (right of center). The lines of the writer are concatenated into a single strip, cut into slices of width $448$ pixels, and $5$ slices are stacked vertically into a $448\times 448$ batch (right), with unused space padded in white. Slices do not necessarily align with the original lines. Batches are subsequently combined into $2\times 2$ mosaics (not shown)}{figure.2}{}}
